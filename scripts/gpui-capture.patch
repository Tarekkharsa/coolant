@@ -1352,4 +1374,28 @@
 pub struct SurfaceBounds {
     pub bounds: Bounds<ScaledPixels>,
     pub content_mask: ContentMask<ScaledPixels>,
+}
+
+
+/// Writes BGRA pixels as a top-down 32-bit BMP (temporary capture patch).
+fn capture_bmp(path: &std::path::Path, w: usize, h: usize, bgra: &[u8]) {
+    let mut out = Vec::with_capacity(54 + bgra.len());
+    let size = 54 + bgra.len() as u32;
+    out.extend_from_slice(b"BM");
+    out.extend_from_slice(&size.to_le_bytes());
+    out.extend_from_slice(&0u32.to_le_bytes());
+    out.extend_from_slice(&54u32.to_le_bytes());
+    out.extend_from_slice(&40u32.to_le_bytes());
+    out.extend_from_slice(&(w as i32).to_le_bytes());
+    out.extend_from_slice(&(-(h as i32)).to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes());
+    out.extend_from_slice(&32u16.to_le_bytes());
+    out.extend_from_slice(&0u32.to_le_bytes());
+    out.extend_from_slice(&(bgra.len() as u32).to_le_bytes());
+    out.extend_from_slice(&[0u8; 16]);
+    out.extend_from_slice(bgra);
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, &out).is_ok() {
+        let _ = std::fs::rename(&tmp, path);
+    }
 }
